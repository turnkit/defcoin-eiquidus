extends layout

block page_intro
  .col-md-12.cardSpacer
    #page-header-container.explorer-hero
      #page-title-container.explorer-hero-brand
        .explorer-hero-copy
          h3#page-title How To Mine Defcoin
          .sub-page-header.text-muted
            | Set up a wallet and compare hardware estimates using DC903 pool and Defcoin network data.
        +defcoinPageBranding('explorer-hero-mark')
    .cardSpacer.clearfix

block content
  script(type='application/json', id='defcoinMiningCatalogData') !{JSON.stringify(miningCatalog)}
  script(src=assetPath('/js/defcoin-mine.js'))
  .col-12
    .card.card-default.border-0.cardSpacer
      .card-header
        strong 1. Install A Wallet First
      .card-body
        .defcoin-callout
          p.mb-2.defcoin-helper
            | The table below lists x86_64 downloads from the official
            a.ms-1(href=miningCatalog.releases.githubReleaseUrl)= miningCatalog.releases.version
            |  release. Read each platform's compatibility notes before using these older builds.
          p.mb-0.defcoin-helper
            | These Intel macOS downloads have not been verified on Apple Silicon. Check a wallet's own release notes for native support and tested platforms.
        .defcoin-callout.mt-3
          p.mb-0.defcoin-helper
            | A paper wallet can receive coins before you install a desktop wallet. Save its private key offline and share only the public address. You can later import or sweep it into a full wallet.
        .table-responsive
          table.table.table-bordered.table-striped.table-hover
            thead
              tr
                th Platform
                th Asset
                th Notes
            tbody
              each wallet in miningCatalog.releases.downloads
                tr
                  td= wallet.id
                  td
                    a(href=wallet.url)= wallet.label
                  td= wallet.compatibility

  .col-12
    .card.card-default.border-0.cardSpacer
      .card-header
        strong 2. Ways To Get Defcoin
      .card-body
        p.defcoin-helper
          | A small transfer lets you test receiving coins before setting up a miner.
        ul
          each method in miningCatalog.obtainMethods
            li= method
        p.defcoin-helper.mt-3.mb-0
          | Use the
          a.ms-1(href='https://defcoin.dc903.org/paperwallet') Paper Wallet
          |  page to create an address and private key. Keep the key secret and share only the address.

  .col-12
    .card.card-default.border-0.cardSpacer
      .card-header
        strong 3. Pick A Mining Path That Matches Your Gear
      .card-body
        .defcoin-page-grid.two-up
          .defcoin-stat-card
            span.stat-label CPU Mining
            p.mb-2.defcoin-helper
              | An existing CPU lets you try mining with little extra hardware. Its hashrate is usually lower than a GPU or ASIC.
            p.mb-0.defcoin-helper
              | The table includes a Ryzen 9 3900X example.
          .defcoin-stat-card
            span.stat-label GPU Mining
            p.mb-2.defcoin-helper
              | An older gaming card can offer more hashrate than a CPU, though setup takes more work.
            p.mb-0.defcoin-helper
              | The table includes an RX 580-class example.
          .defcoin-stat-card
            span.stat-label ASIC Mining
            p.mb-2.defcoin-helper
              | Scrypt ASICs offer more hashrate, with added fan noise, heat, and power use.
            p.mb-0.defcoin-helper
              | The examples include the L3+ and Mini-DOGE III.
          .defcoin-stat-card
            span.stat-label Reality Check
            p.mb-2.defcoin-helper
              | Defcoin has few active miners in these 2026 observations. A change in participating hashrate can move the estimates sharply.
            p.mb-0.defcoin-helper
              | Check your power cost. These estimates do not guarantee profit.

  .col-12
    .card.card-default.border-0.cardSpacer
      .card-header
        strong 4. Example Hardware And Live Estimates
      .card-body
        .defcoin-callout
          p.mb-2.defcoin-helper
            | Prices are curated 2026 used-market snapshots. Yield estimates refresh from current pool and network data.
          p.mb-0.defcoin-helper
            | Recent Pool Pace uses observed activity; Long-Run Expected estimates yield over time. Both are estimates.
        .defcoin-status-grid
          .defcoin-stat-card
            span.stat-label Catalog Checked
            span.stat-value#miningCatalogChecked= miningCatalog.checkedOn
          .defcoin-stat-card
            span.stat-label Default Power Cost
            span.stat-value#miningPowerCostDefault $0.12 / kWh
          .defcoin-stat-card
            span.stat-label Current Pool Context
            span.stat-value#miningPoolContext Loading live estimates
          .defcoin-stat-card
            span.stat-label Current Network Context
            span.stat-value#miningNetworkContext Loading live estimates
        .table-responsive
          table#mining-estimates-table.table.table-bordered.table-striped.table-hover
            thead
              tr
                th Rig
                th Type
                th Hashrate
                th Watts
                th Used Price Range
                th Power Cost / Day
                th Recent Pool Pace
                th Long-Run Expected
                th Sources
            tbody
              tr
                td.text-center(colspan='9') Loading live mining estimates

  .col-12
    .card.card-default.border-0.cardSpacer
      .card-header
        strong 5. Basic Beginner Flow
      .card-body
        ol
          li Install a wallet first and make sure you can open it, receive to a fresh address, and back up the wallet or private key.
          li Obtain a small amount of Defcoin by gift, transfer, paper wallet, or mining so you can test that your wallet and explorer lookups work.
          li Decide whether you are learning with a CPU or GPU you already own, or buying an ASIC on purpose.
          li Compare your power cost against the live estimates below before you point hardware at the pool.
          li Mine to an address you control, then check your shares, balances, and found blocks on the Pool and Explorer pages.
