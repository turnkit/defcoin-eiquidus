          script(type='application/json', id='defcoin-stats-archive-data')!= (typeof defcoinStatsHistoricalJson !== 'undefined' && defcoinStatsHistoricalJson ? defcoinStatsHistoricalJson : '{"sources":[],"samples":[]}')
          script.
            (function() {
              const dataEl = document.getElementById('defcoin-stats-archive-data');
              const canvas = document.getElementById('defcoin-stats-archive-chart');
              const empty = document.getElementById('defcoin-stats-archive-empty');
              const tooltip = document.getElementById('defcoin-stats-archive-tooltip');
              const legend = document.getElementById('defcoin-stats-archive-legend');
              const seriesControls = document.getElementById('defcoin-stats-archive-series-controls');
              const rangeLabel = document.getElementById('defcoin-stats-archive-range-label');
              const windowControl = document.getElementById('defcoin-stats-archive-window');
              const selection = windowControl ? windowControl.querySelector('.defcoin-hashrate-window-selection') : null;
              const startHandle = windowControl ? windowControl.querySelector('.defcoin-hashrate-window-handle-start') : null;
              const endHandle = windowControl ? windowControl.querySelector('.defcoin-hashrate-window-handle-end') : null;
              const presetButtons = Array.from(document.querySelectorAll('.defcoin-stats-archive-preset'));
              const timelineTools = window.DefcoinTimelineTools || null;
              if (!dataEl || !canvas || !empty || !legend || !rangeLabel || !windowControl || !selection || !startHandle || !endHandle) return;
              let chartData = {sources: [], samples: []};
              try { chartData = JSON.parse(dataEl.textContent || '{}'); } catch (err) {}
              const allSamples = (chartData.samples || []).filter((sample) => Number(sample.t) > 0 && Number(sample.hashrate) > 0).sort((a, b) => Number(a.t) - Number(b.t));
              const sourceById = new Map((chartData.sources || []).map((source) => [source.id, source]));
              let activeSourceIds = new Set(Array.from(sourceById.keys()));
              let archiveHoverState = null;
              let archiveHoverPending = false;
              const seriesRateElements = new Map();
              const ranges = {
                '1h': {label: '1H', ms: 60 * 60 * 1000},
                '2h': {label: '2H', ms: 2 * 60 * 60 * 1000},
                '6h': {label: '6H', ms: 6 * 60 * 60 * 1000},
                '12h': {label: '12H', ms: 12 * 60 * 60 * 1000},
                '24h': {label: '24H', ms: 24 * 60 * 60 * 1000},
                '2d': {label: '2D', ms: 2 * 24 * 60 * 60 * 1000},
                '7d': {label: '7D', ms: 7 * 24 * 60 * 60 * 1000},
                month: {label: 'Month', ms: 30 * 24 * 60 * 60 * 1000},
                year: {label: 'Year', ms: 365 * 24 * 60 * 60 * 1000},
                all: {label: 'All', ms: Infinity}
              };
              const rawMinT = allSamples.length ? Number(allSamples[0].t) : Date.now() - ranges.year.ms;
              const rawMaxT = allSamples.length ? Number(allSamples[allSamples.length - 1].t) : Date.now();
              const dataMinT = rawMinT === rawMaxT ? rawMinT - ranges['24h'].ms : rawMinT;
              const dataMaxT = rawMinT === rawMaxT ? rawMaxT + ranges['24h'].ms : rawMaxT;
              const minSpan = Math.min(0.02, Math.max(0.000001, (60 * 60 * 1000) / Math.max(1, dataMaxT - dataMinT)));
              let windowStart = 0;
              let windowEnd = 1;
              let activePreset = 'all';
              let drawPending = false;

              function formatHashrate(value) {
                const numeric = Number(value || 0);
                if (!Number.isFinite(numeric) || numeric <= 0) return '-';
                const units = ['H/s', 'KH/s', 'MH/s', 'GH/s', 'TH/s'];
                let rate = numeric;
                let unitIndex = 0;
                while (rate >= 1000 && unitIndex < units.length - 1) {
                  rate /= 1000;
                  unitIndex += 1;
                }
                return `${rate.toFixed(rate >= 100 ? 0 : 2)} ${units[unitIndex]}`;
              }

              function durationText(ms) {
                const seconds = Math.max(0, Math.round(ms / 1000));
                const minutes = Math.floor(seconds / 60);
                const remainder = seconds % 60;
                if (minutes < 60) return remainder === 0 ? `${minutes} min` : `${minutes} min ${remainder} sec`;
                const hours = Math.floor(minutes / 60);
                const minuteRemainder = minutes % 60;
                if (hours >= 24) {
                  const days = Math.floor(hours / 24);
                  const hourRemainder = hours % 24;
                  const dayText = days === 1 ? '1 day' : `${days} days`;
                  if (days >= 365) {
                    const years = Math.floor(days / 365);
                    const dayRemainder = days % 365;
                    const yearText = years === 1 ? '1 year' : `${years} years`;
                    return dayRemainder === 0 ? yearText : `${yearText} ${dayRemainder} days`;
                  }
                  return hourRemainder === 0 ? dayText : `${dayText} ${hourRemainder} hr`;
                }
                return minuteRemainder === 0 ? `${hours} hr` : `${hours} hr ${minuteRemainder} min`;
              }

              function formatDate(value) {
                return new Date(value).toLocaleString([], {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                  hour: 'numeric',
                  minute: '2-digit'
                });
              }

              function formatTickDate(value, spanMs) {
                if (spanMs <= 2 * ranges['24h'].ms) {
                  return new Date(value).toLocaleString([], {month: 'numeric', day: 'numeric', hour: 'numeric', minute: '2-digit'});
                }
                return new Date(value).toLocaleDateString([], {year: 'numeric', month: 'short'});
              }

              function activeSources() {
                return activeSourceIds.size ? activeSourceIds : new Set();
              }

              function installSeriesControls() {
                if (!seriesControls) return;
                const sources = Array.from(sourceById.values()).sort((a, b) => {
                  if (a.kind === 'network' && b.kind !== 'network') return -1;
                  if (a.kind !== 'network' && b.kind === 'network') return 1;
                  return String(a.name).localeCompare(String(b.name));
                });
                seriesControls.querySelectorAll('.defcoin-series-toggle-label').forEach((node) => node.remove());
                seriesRateElements.clear();
                sources.forEach((source) => {
                  const label = document.createElement('label');
                  label.className = 'defcoin-chart-toggle defcoin-series-toggle-label';
                  const input = document.createElement('input');
                  input.type = 'checkbox';
                  input.className = 'defcoin-series-toggle';
                  input.value = source.id;
                  input.checked = activeSourceIds.has(source.id);
                  const swatch = document.createElement('span');
                  swatch.className = 'defcoin-hashrate-swatch';
                  swatch.style.background = source.color || '#d8dee9';
                  const text = document.createElement('span');
                  text.className = 'defcoin-series-name';
                  text.textContent = source.name;
                  const rate = document.createElement('span');
                  rate.className = 'defcoin-series-rate';
                  rate.textContent = '-';
                  input.addEventListener('change', () => {
                    if (input.checked) activeSourceIds.add(source.id);
                    else activeSourceIds.delete(source.id);
                    scheduleDraw();
                  });
                  label.appendChild(input);
                  label.appendChild(swatch);
                  label.appendChild(text);
                  label.appendChild(rate);
                  seriesControls.appendChild(label);
                  seriesRateElements.set(source.id, rate);
                });
              }

              function updateSeriesRates(samples) {
                if (!seriesControls) return;
                const latestBySource = new Map();
                (samples || []).forEach((sample) => {
                  latestBySource.set(sample.sourceId, sample);
                });
                Array.from(sourceById.values()).forEach((source) => {
                  const rate = seriesRateElements.get(source.id);
                  if (!rate) return;
                  const latest = latestBySource.get(source.id);
                  rate.textContent = latest ? formatHashrate(latest.hashrate) : '-';
                  rate.classList.toggle('is-empty', !latest);
                });
              }

              function hideArchiveTooltip() {
                if (tooltip) tooltip.style.display = 'none';
              }

              function updateArchiveTooltip(event) {
                if (!archiveHoverState || !tooltip) return;
                const rect = canvas.getBoundingClientRect();
                const mx = event.clientX - rect.left;
                const my = event.clientY - rect.top;
                if (timelineTools && archiveHoverState.eventHitboxes && archiveHoverState.eventHitboxes.length) {
                  const eventHit = timelineTools.findEventHit(archiveHoverState.eventHitboxes, mx, my);
                  if (eventHit) {
                    timelineTools.showEventTooltip(tooltip, canvas, eventHit, mx, my);
                    return;
                  }
                }
                let best = null;
                let bestDistance = Infinity;
                archiveHoverState.points.forEach((point) => {
                  const dx = point.x - mx;
                  const dy = point.y - my;
                  const distance = dx * dx + dy * dy;
                  if (distance < bestDistance) {
                    best = point;
                    bestDistance = distance;
                  }
                });
                if (!best || bestDistance > 22 * 22) {
                  hideArchiveTooltip();
                  return;
                }
                tooltip.innerHTML = `<strong>${best.sourceName}</strong><span>${formatHashrate(best.hashrate)}</span><span>${formatDate(best.t)}</span>`;
                const tooltipWidth = 230;
                const left = Math.max(8, Math.min(rect.width - tooltipWidth - 8, best.x + 14));
                const top = Math.max(8, Math.min(rect.height - 76, best.y - 44));
                tooltip.style.left = `${left}px`;
                tooltip.style.top = `${top}px`;
                tooltip.style.display = 'block';
              }

              function scheduleArchiveTooltip(event) {
                if (!tooltip) return;
                const lastEvent = {clientX: event.clientX, clientY: event.clientY};
                if (archiveHoverPending) {
                  canvas._defcoinLastHoverEvent = lastEvent;
                  return;
                }
                archiveHoverPending = true;
                canvas._defcoinLastHoverEvent = lastEvent;
                requestAnimationFrame(() => {
                  archiveHoverPending = false;
                  updateArchiveTooltip(canvas._defcoinLastHoverEvent);
                });
              }

              function timeForPosition(pos) {
                return dataMinT + Math.max(0, Math.min(1, pos)) * (dataMaxT - dataMinT);
              }

              function positionForTime(time) {
                if (dataMaxT <= dataMinT) return 0;
                return Math.max(0, Math.min(1, (time - dataMinT) / (dataMaxT - dataMinT)));
              }

              function minimumWindowSpan() {
                const width = windowControl ? windowControl.getBoundingClientRect().width : 0;
                const visualSpan = width > 0 ? 18 / width : 0;
                return Math.min(1, Math.max(minSpan, visualSpan));
              }

              function clampWindow(start, end) {
                start = Number.isFinite(start) ? start : 0;
                end = Number.isFinite(end) ? end : 1;
                const minWindowSpan = minimumWindowSpan();
                let span = Math.max(minWindowSpan, end - start);
                if (span >= 1) {
                  windowStart = 0;
                  windowEnd = 1;
                  return;
                }
                start = Math.max(0, Math.min(1 - span, start));
                windowStart = start;
                windowEnd = start + span;
              }

              function updatePresetState(preset) {
                activePreset = preset || 'custom';
                presetButtons.forEach((button) => {
                  button.classList.toggle('active', button.dataset.range === activePreset);
                });
              }

              function bestPresetForSpan(spanMs) {
                if (!Number.isFinite(spanMs) || spanMs <= 0) return 'custom';
                const fullSpan = Math.max(1, rawMaxT - rawMinT);
                if (spanMs >= fullSpan * 0.94) return 'all';
                let bestPreset = 'custom';
                let bestScore = Infinity;
                Object.keys(ranges).forEach((key) => {
                  const config = ranges[key];
                  if (!Number.isFinite(config.ms)) return;
                  const score = Math.abs(Math.log(spanMs / config.ms));
                  if (score < bestScore) {
                    bestPreset = key;
                    bestScore = score;
                  }
                });
                return bestScore <= Math.log(1.35) ? bestPreset : 'custom';
              }

              function syncPresetStateFromWindow() {
                updatePresetState(bestPresetForSpan(timeForPosition(windowEnd) - timeForPosition(windowStart)));
              }

              function centeredRangeForDuration(durationMs, minTime, maxTime) {
                const domainSpan = Math.max(1, maxTime - minTime);
                const width = Math.min(durationMs, domainSpan);
                let center = (timeForPosition(windowStart) + timeForPosition(windowEnd)) / 2;
                if (!Number.isFinite(center)) center = maxTime - width / 2;
                center = Math.max(minTime + width / 2, Math.min(maxTime - width / 2, center));
                return {
                  start: center - width / 2,
                  end: center + width / 2
                };
              }

              function setPreset(preset, preserveCenter) {
                const config = ranges[preset] || ranges.all;
                if (preset === 'all' || !Number.isFinite(config.ms)) {
                  clampWindow(positionForTime(rawMinT), positionForTime(rawMaxT));
                } else {
                  if (preserveCenter === false) {
                    const endTime = dataMaxT;
                    const startTime = Math.max(dataMinT, endTime - config.ms);
                    clampWindow(positionForTime(startTime), positionForTime(endTime));
                  } else {
                    const centeredRange = centeredRangeForDuration(config.ms, dataMinT, dataMaxT);
                    clampWindow(positionForTime(centeredRange.start), positionForTime(centeredRange.end));
                  }
                }
                updatePresetState(preset);
                scheduleDraw();
              }

              function updateWindowControl() {
                const startPercent = windowStart * 100;
                const endPercent = windowEnd * 100;
                selection.style.left = `${startPercent}%`;
                selection.style.width = `${Math.max(0, endPercent - startPercent)}%`;
                startHandle.style.left = `${startPercent}%`;
                endHandle.style.left = `${endPercent}%`;
                const startTime = timeForPosition(windowStart);
                const endTime = timeForPosition(windowEnd);
                rangeLabel.textContent = `${formatDate(startTime)} - ${formatDate(endTime)} | ${durationText(endTime - startTime)} selected`;
              }

              function scheduleDraw() {
                if (drawPending) return;
                drawPending = true;
                requestAnimationFrame(() => {
                  drawPending = false;
                  drawArchiveChart();
                });
              }

              function downsample(points, maxPoints) {
                if (points.length <= maxPoints) return points;
                const stride = Math.ceil(points.length / maxPoints);
                const sampled = [];
                for (let index = 0; index < points.length; index += stride) {
                  sampled.push(points[index]);
                }
                const last = points[points.length - 1];
                if (sampled[sampled.length - 1] !== last) sampled.push(last);
                return sampled;
              }

              function normalizedMousePosition(event) {
                const rect = windowControl.getBoundingClientRect();
                return Math.max(0, Math.min(1, (event.clientX - rect.left) / Math.max(1, rect.width)));
              }

              function installWindowDrag() {
                let dragMode = 'none';
                let pressStart = 0;
                let pressEnd = 1;
                let pressX = 0;
                windowControl.addEventListener('pointerdown', (event) => {
                  const pos = normalizedMousePosition(event);
                  const controlRect = windowControl.getBoundingClientRect();
                  const edgeThreshold = Math.max(0.018, 16 / Math.max(1, controlRect.width));
                  pressStart = windowStart;
                  pressEnd = windowEnd;
                  pressX = pos;
                  const insideSelection = pos >= pressStart && pos <= pressEnd;
                  const selectionPixels = Math.abs(pressEnd - pressStart) * Math.max(1, controlRect.width);
                  const pointerPx = pos * Math.max(1, controlRect.width);
                  const startPx = pressStart * Math.max(1, controlRect.width);
                  const endPx = pressEnd * Math.max(1, controlRect.width);
                  const resizeBandPx = Math.min(18, Math.max(8, selectionPixels * 0.22));
                  windowControl.setPointerCapture(event.pointerId);
                  if (insideSelection) {
                    if (selectionPixels <= 72) {
                      dragMode = 'move';
                    } else if (pointerPx - startPx <= resizeBandPx) {
                      dragMode = 'left';
                    } else if (endPx - pointerPx <= resizeBandPx) {
                      dragMode = 'right';
                    } else {
                      dragMode = 'move';
                    }
                  } else if (Math.abs(pos - windowStart) < edgeThreshold) {
                    dragMode = 'left';
                  } else if (Math.abs(pos - windowEnd) < edgeThreshold) {
                    dragMode = 'right';
                  } else {
                    const span = windowEnd - windowStart;
                    clampWindow(pos - span / 2, pos + span / 2);
                    dragMode = 'move';
                    pressStart = windowStart;
                    pressEnd = windowEnd;
                    pressX = pos;
                    syncPresetStateFromWindow();
                    scheduleDraw();
                  }
                  event.preventDefault();
                });
                windowControl.addEventListener('pointermove', (event) => {
                  if (dragMode === 'none') return;
                  const pos = normalizedMousePosition(event);
                  const minWindowSpan = minimumWindowSpan();
                  if (dragMode === 'left') {
                    clampWindow(Math.min(pos, pressEnd - minWindowSpan), pressEnd);
                  } else if (dragMode === 'right') {
                    clampWindow(pressStart, Math.max(pos, pressStart + minWindowSpan));
                  } else if (dragMode === 'move') {
                    const delta = pos - pressX;
                    clampWindow(pressStart + delta, pressEnd + delta);
                  }
                  syncPresetStateFromWindow();
                  scheduleDraw();
                });
                windowControl.addEventListener('pointerup', (event) => {
                  if (windowControl.hasPointerCapture(event.pointerId)) {
                    windowControl.releasePointerCapture(event.pointerId);
                  }
                  dragMode = 'none';
                });
                windowControl.addEventListener('pointercancel', () => {
                  dragMode = 'none';
                });
                windowControl.addEventListener('keydown', (event) => {
                  const span = windowEnd - windowStart;
                  const moveStep = event.shiftKey ? 0.08 : 0.02;
                  let handled = true;
                  if (event.key === 'ArrowLeft') {
                    clampWindow(windowStart - moveStep, windowEnd - moveStep);
                  } else if (event.key === 'ArrowRight') {
                    clampWindow(windowStart + moveStep, windowEnd + moveStep);
                  } else if (event.key === 'ArrowUp' || event.key === '+') {
                    const midpoint = (windowStart + windowEnd) / 2;
                    const nextSpan = Math.max(minimumWindowSpan(), span * 0.86);
                    clampWindow(midpoint - nextSpan / 2, midpoint + nextSpan / 2);
                  } else if (event.key === 'ArrowDown' || event.key === '-') {
                    const midpoint = (windowStart + windowEnd) / 2;
                    const nextSpan = Math.min(1, span * 1.18);
                    clampWindow(midpoint - nextSpan / 2, midpoint + nextSpan / 2);
                  } else {
                    handled = false;
                  }
                  if (handled) {
                    event.preventDefault();
                    syncPresetStateFromWindow();
                    scheduleDraw();
                  }
                });
              }

              function drawArchiveChart() {
                updateWindowControl();
                const windowStartMs = timeForPosition(windowStart);
                const windowEndMs = timeForPosition(windowEnd);
                const visibleSourceIds = activeSources();
                const samples = allSamples.filter((sample) => visibleSourceIds.has(sample.sourceId) && Number(sample.t) >= windowStartMs && Number(sample.t) <= windowEndMs);
                if (!samples.length) {
                  empty.style.display = 'flex';
                  legend.innerHTML = '';
                  updateSeriesRates([]);
                  archiveHoverState = null;
                  hideArchiveTooltip();
                  const ctx = canvas.getContext('2d');
                  ctx.clearRect(0, 0, canvas.width, canvas.height);
                  if (timelineTools) {
                    timelineTools.renderVisibleEventList({
                      listId: 'defcoin-archive-event-list',
                      countId: 'defcoin-archive-event-count',
                      minT: windowStartMs,
                      maxT: windowEndMs,
                      controlsId: 'defcoin-archive-event-controls'
                    });
                    timelineTools.updateEnergyEstimator({
                      panelId: 'defcoin-archive-energy-panel',
                      samples,
                      startMs: windowStartMs,
                      endMs: windowEndMs,
                      formatHashrate,
                      durationText
                    });
                  }
                  return;
                }
                empty.style.display = 'none';
                const rect = canvas.getBoundingClientRect();
                const dpr = window.devicePixelRatio || 1;
                const width = Math.max(640, rect.width || 1000);
                const height = Math.max(380, rect.height || 420);
                canvas.width = width * dpr;
                canvas.height = height * dpr;
                const ctx = canvas.getContext('2d');
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                ctx.clearRect(0, 0, width, height);

                const minT = windowStartMs;
                const maxT = windowEndMs;
                const selectedSpan = Math.max(1, maxT - minT);
                const maxLog = Math.max(1, Math.ceil(Math.max.apply(null, samples.map((sample) => Math.log10(Number(sample.hashrate) + 1)))));
                const pad = {left: 96, right: 34, top: 32, bottom: 48};
                const plotWidth = width - pad.left - pad.right;
                const plotHeight = height - pad.top - pad.bottom;
                const eventHitboxes = [];
                function xFor(t) { return pad.left + ((Number(t) - minT) / Math.max(1, maxT - minT)) * plotWidth; }
                function yFor(hps) { return pad.top + plotHeight - (Math.log10(Number(hps) + 1) / maxLog) * plotHeight; }

                if (timelineTools) {
                  timelineTools.drawEventBands({
                    ctx,
                    minT,
                    maxT,
                    pad,
                    plotWidth,
                    plotHeight,
                    xFor,
                    controlsId: 'defcoin-archive-event-controls',
                    eventHitboxes
                  });
                  timelineTools.renderVisibleEventList({
                    listId: 'defcoin-archive-event-list',
                    countId: 'defcoin-archive-event-count',
                    minT,
                    maxT,
                    controlsId: 'defcoin-archive-event-controls'
                  });
                }

                ctx.font = '12px ui-monospace, SFMono-Regular, Menlo, monospace';
                ctx.strokeStyle = 'rgba(255,255,255,0.10)';
                ctx.fillStyle = 'rgba(255,255,255,0.68)';
                ctx.textAlign = 'right';
                ctx.textBaseline = 'middle';
                for (let i = 0; i <= 4; i += 1) {
                  const ratio = i / 4;
                  const y = pad.top + plotHeight - ratio * plotHeight;
                  ctx.beginPath();
                  ctx.moveTo(pad.left, y);
                  ctx.lineTo(width - pad.right, y);
                  ctx.stroke();
                  ctx.fillText(formatHashrate(Math.pow(10, ratio * maxLog) - 1), pad.left - 12, y);
                }

                const hoverPoints = [];
                Array.from(sourceById.values()).filter((source) => visibleSourceIds.has(source.id)).forEach((source) => {
                  const points = downsample(samples.filter((sample) => sample.sourceId === source.id), Math.max(260, Math.floor(plotWidth * 1.8)));
                  if (!points.length) return;
                  ctx.strokeStyle = source.color || '#d8dee9';
                  ctx.globalAlpha = source.kind === 'network' ? 1 : 0.72;
                  ctx.lineWidth = source.kind === 'network' ? 2.4 : 1.2;
                  ctx.beginPath();
                  points.forEach((point, index) => {
                    const x = xFor(point.t);
                    const y = yFor(point.hashrate);
                    if (index === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                  });
                  ctx.stroke();
                  ctx.globalAlpha = 1;
                  samples.filter((sample) => sample.sourceId === source.id).forEach((point) => {
                    hoverPoints.push({
                      x: xFor(point.t),
                      y: yFor(point.hashrate),
                      t: Number(point.t),
                      hashrate: Number(point.hashrate),
                      sourceName: source.name
                    });
                  });
                });
                archiveHoverState = {points: hoverPoints, eventHitboxes};

                ctx.strokeStyle = 'rgba(255,255,255,0.24)';
                ctx.beginPath();
                ctx.moveTo(pad.left, pad.top);
                ctx.lineTo(pad.left, pad.top + plotHeight);
                ctx.lineTo(width - pad.right, pad.top + plotHeight);
                ctx.stroke();
                ctx.fillStyle = 'rgba(255,255,255,0.68)';
                ctx.textBaseline = 'top';
                ctx.textAlign = 'left';
                ctx.fillText(formatTickDate(minT, selectedSpan), pad.left, height - 30);
                ctx.textAlign = 'right';
                ctx.fillText(formatTickDate(maxT, selectedSpan), width - pad.right, height - 30);
                ctx.textAlign = 'left';
                ctx.fillText('Log scale', pad.left, 10);

                legend.innerHTML = '';
                updateSeriesRates(samples);
                if (timelineTools) {
                  timelineTools.updateEnergyEstimator({
                    panelId: 'defcoin-archive-energy-panel',
                    samples,
                    startMs: windowStartMs,
                    endMs: windowEndMs,
                    formatHashrate,
                    durationText
                  });
                }
              }
              presetButtons.forEach((button) => {
                button.addEventListener('click', () => setPreset(button.dataset.range || 'all'));
              });
              if (timelineTools) {
                timelineTools.installEventControls('defcoin-archive-event-controls', scheduleDraw);
                timelineTools.installEnergyEstimator('defcoin-archive-energy-panel', scheduleDraw);
              }
              installSeriesControls();
              if (tooltip) {
                canvas.addEventListener('mousemove', scheduleArchiveTooltip);
                canvas.addEventListener('mouseleave', hideArchiveTooltip);
              }
              installWindowDrag();
              window.addEventListener('resize', scheduleDraw);
              setPreset('all');
            })();

          details.defcoin-disclosure.defcoin-chronological-events-disclosure#defcoin-chronological-events
            summary.defcoin-disclosure-summary.defcoin-chronological-events-summary
              span.defcoin-disclosure-arrow(aria-hidden='true')
              span.defcoin-event-history-title Chronological Event History
              span.defcoin-event-history-filter-shell#defcoin-event-history-filter-shell
                span.defcoin-event-history-filter-group
                  span.defcoin-event-history-filter-label Type
                  span.defcoin-event-history-filter-options#defcoin-event-history-type-filters
                span.defcoin-event-history-filter-group
                  span.defcoin-event-history-filter-label Structure
                  span.defcoin-event-history-filter-options#defcoin-event-history-structure-filters
              span.defcoin-disclosure-count#defcoin-event-history-count 0
            .defcoin-event-history-body
              p.defcoin-helper
                | Complete timeline entries sorted newest to oldest. Release and build records are point events; conferences and confirmed activity windows remain ranges.
              .defcoin-event-history-list#defcoin-event-history-list
          script.
            (function() {
              const dataEl = document.getElementById('defcoin-timeline-events-data');
              const typeContainer = document.getElementById('defcoin-event-history-type-filters');
              const structureContainer = document.getElementById('defcoin-event-history-structure-filters');
              const filterShell = document.getElementById('defcoin-event-history-filter-shell');
              const list = document.getElementById('defcoin-event-history-list');
              const count = document.getElementById('defcoin-event-history-count');
              if (!dataEl || !typeContainer || !structureContainer || !list) return;

              let payload = {events: []};
              try {
                payload = JSON.parse(dataEl.textContent || '{}');
              } catch (err) {
                payload = {events: []};
              }
              const events = (Array.isArray(payload.events) ? payload.events : [])
                .filter((event) => event && event.chartVisible !== false);

              const typeLabels = {
                chain: 'Chain',
                conference: 'DEF CON',
                event: 'Event',
                mining: 'Mining',
                pool: 'Pools',
                project: 'Project',
                release: 'Releases',
                site: 'Site',
                stats: 'Stats',
                utility: 'Utility'
              };
              const typeOrder = ['release', 'chain', 'pool', 'mining', 'stats', 'project', 'site', 'utility', 'conference', 'event'];
              const structureLabels = {point: 'Point events', range: 'Ranges'};
              const structureOrder = ['point', 'range'];
              const activeTypes = new Set();
              const activeStructures = new Set(structureOrder);

              function hasExplicitTime(value) {
                return /T\d{2}:?\d{2}/.test(String(value || ''));
              }

              function fullDateTimeLabel(value) {
                const date = new Date(value);
                if (!Number.isFinite(date.getTime())) return '';
                return date.toLocaleString([], {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                  hour: 'numeric',
                  minute: '2-digit',
                  timeZoneName: 'short'
                });
              }

              function fullDateOnlyLabel(value) {
                const date = new Date(value);
                if (!Number.isFinite(date.getTime())) return '';
                return `${date.toLocaleDateString([], {year: 'numeric', month: 'short', day: 'numeric'})} (time unknown)`;
              }

              function eventType(event) {
                if (event.category === 'conference') return 'conference';
                return event.subcategory || event.category || 'event';
              }

              function eventStructure(event) {
                return event.isPointEvent ? 'point' : 'range';
              }

              function eventSortTime(event) {
                if (event.eventAt) {
                  const exact = Date.parse(event.eventAt);
                  if (Number.isFinite(exact)) return exact;
                }
                const start = Number(event.startMs);
                if (Number.isFinite(start)) return start;
                const fallback = Date.parse(`${event.startDate || event.date || '1970-01-01'}T00:00:00Z`);
                return Number.isFinite(fallback) ? fallback : 0;
              }

              function eventPointDate(event) {
                if (event.eventAtText) return event.eventAtText;
                if (event.eventAt && !hasExplicitTime(event.eventAt)) return fullDateOnlyLabel(event.startMs || event.eventAt);
                return fullDateTimeLabel(event.startMs || event.eventAt);
              }

              function eventBoundaryDate(event, fieldName, dateFieldName, msValue) {
                if (event[fieldName] && !hasExplicitTime(event[fieldName])) return fullDateOnlyLabel(msValue || event[fieldName]);
                if (event[dateFieldName]) return fullDateOnlyLabel(msValue || event[dateFieldName]);
                return fullDateTimeLabel(msValue || event[fieldName] || event[dateFieldName]);
              }

              function eventDateText(event) {
                if (event.isPointEvent) {
                  return `Event date: ${eventPointDate(event)}`;
                }
                const startText = eventBoundaryDate(event, 'startAt', 'startDate', event.startMs);
                const endText = eventBoundaryDate(event, 'endAt', 'endDate', event.endMs);
                return `Start: ${startText} | End: ${endText}`;
              }

              function makeFilter(container, groupName, value, label, activeSet) {
                const option = document.createElement('label');
                option.className = 'defcoin-chart-toggle defcoin-event-history-filter';
                const input = document.createElement('input');
                input.type = 'checkbox';
                input.name = groupName;
                input.value = value;
                input.checked = activeSet.has(value);
                input.addEventListener('change', () => {
                  if (input.checked) activeSet.add(value);
                  else activeSet.delete(value);
                  renderEvents();
                });
                const text = document.createElement('span');
                text.textContent = label;
                option.appendChild(input);
                option.appendChild(text);
                container.appendChild(option);
              }

              function installFilters() {
                const presentTypes = Array.from(new Set(events.map(eventType))).sort((a, b) => {
                  const ai = typeOrder.indexOf(a);
                  const bi = typeOrder.indexOf(b);
                  if (ai !== -1 || bi !== -1) return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
                  return String(a).localeCompare(String(b));
                });
                presentTypes.forEach((type) => activeTypes.add(type));
                typeContainer.textContent = '';
                structureContainer.textContent = '';
                presentTypes.forEach((type) => makeFilter(typeContainer, 'event-history-type', type, typeLabels[type] || type, activeTypes));
                structureOrder.forEach((structure) => makeFilter(structureContainer, 'event-history-structure', structure, structureLabels[structure], activeStructures));
                if (filterShell) {
                  filterShell.addEventListener('click', (event) => event.stopPropagation());
                  filterShell.addEventListener('keydown', (event) => {
                    if (event.key === ' ' || event.key === 'Enter') event.stopPropagation();
                  });
                }
              }

              function filteredEvents() {
                return events
                  .filter((event) => activeTypes.has(eventType(event)) && activeStructures.has(eventStructure(event)))
                  .sort((a, b) => {
                    const diff = eventSortTime(b) - eventSortTime(a);
                    return diff !== 0 ? diff : String(a.label || '').localeCompare(String(b.label || ''));
                  });
              }

              function renderEvents() {
                const visible = filteredEvents();
                if (count) count.textContent = `${visible.length}/${events.length}`;
                list.textContent = '';
                if (!visible.length) {
                  const empty = document.createElement('div');
                  empty.className = 'defcoin-visible-events-empty';
                  empty.textContent = 'No events match the selected filters.';
                  list.appendChild(empty);
                  return;
                }
                const fragment = document.createDocumentFragment();
                visible.forEach((event) => {
                  const row = document.createElement('div');
                  row.className = 'defcoin-visible-event-row defcoin-event-history-row';
                  const date = document.createElement('div');
                  date.className = 'defcoin-visible-event-date defcoin-event-history-date';
                  date.textContent = eventDateText(event);
                  const body = document.createElement('div');
                  body.className = 'defcoin-visible-event-body defcoin-event-history-body-cell';
                  const title = document.createElement('strong');
                  title.textContent = event.label || event.name || 'Timeline event';
                  const meta = document.createElement('span');
                  meta.className = 'defcoin-visible-event-meta';
                  meta.textContent = `${typeLabels[eventType(event)] || eventType(event)} | ${structureLabels[eventStructure(event)]}`;
                  body.appendChild(title);
                  body.appendChild(meta);
                  if (event.topic || event.buildNumber) {
                    const details = document.createElement('span');
                    details.className = 'defcoin-event-history-detail';
                    details.textContent = [event.topic ? `Topic: ${event.topic}` : '', event.buildNumber ? `Build: ${event.buildNumber}` : ''].filter(Boolean).join(' | ');
                    body.appendChild(details);
                  }
                  if (event.note) {
                    const note = document.createElement('p');
                    note.textContent = event.note;
                    body.appendChild(note);
                  }
                  if (event.sourceUrl) {
                    const link = document.createElement('a');
                    link.href = event.sourceUrl;
                    link.target = '_blank';
                    link.rel = 'noopener noreferrer';
                    link.textContent = 'Source';
                    body.appendChild(link);
                  }
                  row.appendChild(date);
                  row.appendChild(body);
                  fragment.appendChild(row);
                });
                list.appendChild(fragment);
              }

              installFilters();
              renderEvents();
            })();

          hr.my-4
          details.defcoin-disclosure.defcoin-history-pools-disclosure
            summary.defcoin-disclosure-summary
              span.defcoin-disclosure-arrow(aria-hidden='true')
              span Historical Pools
              if miningStats.historicalPoolGroups && miningStats.historicalPoolGroups.length
                span.defcoin-disclosure-count #{miningStats.historicalPoolGroups.reduce((total, group) => total + (group.pools ? group.pools.length : 0), 0)}
            .defcoin-history-pools-body
              p.defcoin-helper
                | Historical pools are grouped by the first known activity year from the local History page, DefcoinStats, and Wayback references. Active modern P2Pool endpoints are intentionally not duplicated here.
              if miningStats.defcoinStatsError
                .alert.alert-warning(role='alert') DefcoinStats could not be refreshed, so historical rows are shown from the local History catalog only: #{miningStats.defcoinStatsError}
              if miningStats.historicalPoolGroups && miningStats.historicalPoolGroups.length
                each group in miningStats.historicalPoolGroups
                  h4.mt-4 #{group.year}
                  .table-responsive
                    table.table.table-bordered.table-striped.table-hover
                      thead
                        tr
                          th Pool
                          th Operator
                          th Last Known Activity
                          th First Seen
                          th Original URL
                          th Backend
                          th DefcoinStats Snapshot
                      tbody
                        each pool in group.pools
                          tr
                            td #{pool.name}
                            td #{pool.operator || '-'}
                            td
                              if pool.lastSeen && pool.lastSeen.url
                                a(href=pool.lastSeen.url, target='_blank', rel='noopener noreferrer') #{pool.lastSeen.label}
                              else
                                span -
                            td
                              if pool.firstSeen && pool.firstSeen.url
                                a(href=pool.firstSeen.url, target='_blank', rel='noopener noreferrer') #{pool.firstSeen.label}
                              else
                                span -
                            td
                              if pool.originalUrl
                                a(href=pool.originalUrl, target='_blank', rel='noopener noreferrer') #{pool.originalUrl}
                              else
                                span -
                              if pool.archiveUrl
                                div.small
                                  a(href=pool.archiveUrl, target='_blank', rel='noopener noreferrer') Wayback
                            td #{pool.backend || ''}
                            td
                              if pool.defcoinStatsPool
                                div #{miningStats.formatDefcoinStatsHashrate(pool.defcoinStatsPool.currentHashrate)}
                                if pool.defcoinStatsPool.sourceUrl
                                  div.small
                                    a(href=pool.defcoinStatsPool.sourceUrl, target='_blank', rel='noopener noreferrer') DefcoinStats
                              else
                                span -
                          if pool.note
                            tr.defcoin-history-pool-notes-row
                              td
                              td(colspan='6')
                                span.defcoin-history-pool-note-label Notes
                                span #{pool.note}
              else
                p No historical pool rows are available.
              p.small.text-muted.mt-3.mb-0
                | DefcoinStats data updates on its own schedule. Live status here comes from the P2Pool APIs, while historical dates come from the curated History page and archive links.
        else
          p Waiting for mining stats.
