extends layout

block content
  style.
    .defcoin-services-flags {
      display: inline-grid;
      grid-template-columns: repeat(8, 1.15ch);
      column-gap: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
      font-size: 0.92em;
      white-space: nowrap;
      line-height: 0.95;
      vertical-align: middle;
    }
    .defcoin-service-flag {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 2em;
      text-align: center;
    }
    .defcoin-service-flag span {
      display: block;
      height: 0.95em;
    }
    .defcoin-service-flag.is-on {
      color: inherit;
      font-weight: 600;
    }
    .defcoin-service-flag.is-off {
      color: rgba(180, 190, 200, 0.34);
      font-weight: 400;
    }
    #connections-table tbody td {
      color: #f2f5f8 !important;
    }
    #connections-table tbody td .text-muted {
      color: #bcc6d0 !important;
    }
    #connections-table tbody td .defcoin-peer-clamp,
    #connections-table tbody td .defcoin-peer-address,
    #connections-table tbody td .defcoin-service-flag.is-on {
      color: #f2f5f8 !important;
    }
    #connections-table tbody td .defcoin-service-flag.is-off {
      color: rgba(180, 190, 200, 0.34) !important;
    }
  script.
