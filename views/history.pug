extends layout

mixin evidenceLink(evidence)
  if evidence != null && evidence.url != null && evidence.label != null
    a(href=evidence.url)= evidence.label
  else
    span —

block page_intro
  .col-md-12.cardSpacer
    #page-header-container.explorer-hero
      #page-title-container.explorer-hero-brand
        .explorer-hero-copy
          h1#page-title Defcoin History
          .sub-page-header.text-muted
            | How Defcoin was used at DEF CON, how its software and mining community changed, and where the surviving records can be found.
        +defcoinPageBranding('explorer-hero-mark')
    .cardSpacer.clearfix

block content
  .col-12
    .card.card-default.border-0.cardSpacer.defcoin-reading
      .card-header
        h2#community-story The community story
      .card-body
        nav.defcoin-reading-nav(aria-label='On this history page')
          ul
            li
              a(href='#community-story') Community story
            li
              a(href='#community-links') Source directory
            li
              a(href='#pool-evidence') Pool evidence
            li
              a(href='#chain-records') On-chain records
        .defcoin-callout
          p.mb-2.defcoin-helper
            | Defcoin is a cryptocurrency used by members of the DEF CON community to learn about mining and transactions. It has its own blockchain and Litecoin-derived software. Conference talks, the Coindroids game, and community-run services left the records collected here.
          p.mb-0.defcoin-helper
            | History researched on #{researchUpdatedOn}. The original link inventory dates to #{generatedOn}; each service check and archive capture keeps its own date. Unknown dates remain marked as unknown.
        .defcoin-community-story
          each chapter, index in communityStory
            section.defcoin-story-chapter(aria-labelledby=`story-${index}`)
              .defcoin-story-date
                if /^\d{4}-\d{2}-\d{2}$/.test(chapter.date)
                  time(datetime=chapter.date)= chapter.date
                else
                  span= chapter.date
              .defcoin-story-copy
                h3(id=`story-${index}`)= chapter.title
                each paragraph in chapter.paragraphs
                  p.defcoin-helper= paragraph
                ul.defcoin-compact-link-list
                  each source in chapter.sources
                    li
                      a(href=source.url)= source.label
        .defcoin-page-grid.two-up
          .defcoin-stat-card
            span.stat-label Current DC903 pages
            ul.mb-0
              each item in currentSurfaces
                li
                  a(href=item.url)= item.label
          .defcoin-stat-card
            span.stat-label What these records establish
            ul.mb-0
              each note in researchNotes
                li= note

  .col-12
    .card.card-default.border-0.cardSpacer.defcoin-reading
      .card-header
        h2#community-links Community links and further reading
      .card-body
        p.defcoin-scroll-hint Wide tables scroll sideways. Tab to a table, then use the arrow keys.
        .table-responsive(role='region', aria-labelledby='community-links', tabindex='0')
          table.table.table-bordered.table-striped.table-hover
            thead
              tr
                th(scope='col') Link
                th(scope='col') Notes
            tbody
              each item in activeReferences
                tr
                  td
                    a(href=item.url)= item.label
                  td= item.note

  if activePools && activePools.length
    .col-12
      .card.card-default.border-0.cardSpacer.defcoin-reading
        .card-header
          h2#checked-pools Pools with recorded live checks
        .card-body
          .table-responsive(role='region', aria-labelledby='checked-pools', tabindex='0')
            table.table.table-bordered.table-striped.table-hover
              thead
                tr
                  th(scope='col') Pool
                  th(scope='col') Operator
                  th(scope='col') Website
                  th(scope='col') Stratum
                  th(scope='col') Last live check
                  th(scope='col') Notes
              tbody
                each item in activePools
                  tr
                    td= item.name
                    td= item.operator || 'Unknown'
                    td
                      if item.websiteUrl
                        a(href=item.websiteUrl)= item.websiteUrl
                      else
                        span —
                    td
                      if item.stratumUrl
                        code= item.stratumUrl
                      else
                        span —
                    td
                      +evidenceLink(item.lastSeen)
                    td= item.note

  if poolTimeline && poolTimeline.items && poolTimeline.items.length
    .col-12
      .card.card-default.border-0.cardSpacer.defcoin-pool-timeline-card.defcoin-reading
        .card-header
          h2#pool-evidence Pool evidence timeline
        .card-body
          .defcoin-callout
            p.mb-0.defcoin-helper
              | Bars connect the earliest and latest evidence recorded here. They do not prove uninterrupted uptime or give exact launch and shutdown dates. A pool with no dated evidence stays in the tables below.
          .defcoin-pool-timeline(role='region', tabindex='0', aria-label=`Defcoin pool observed timeline from ${poolTimeline.startYear} through ${poolTimeline.endYear}`)
            .defcoin-pool-timeline-inner(style=`grid-template-columns: 74px repeat(${poolTimeline.items.length}, minmax(92px, 1fr));`)
              .defcoin-pool-timeline-axis
                each tick in poolTimeline.ticks
                  .defcoin-pool-timeline-tick(style=`top: ${tick.pct}%;`)
                    span= tick.label
              each item in poolTimeline.items
                .defcoin-pool-timeline-column(title=`${item.name}: ${item.startLabel} to ${item.endLabel}. ${item.note}`)
                  .defcoin-pool-timeline-name
                    if item.url
                      a(href=item.url)= item.name
                    else
                      span= item.name
                  .defcoin-pool-timeline-rail
                    each tick in poolTimeline.ticks
                      .defcoin-pool-timeline-gridline(style=`top: ${tick.pct}%;`)
                    .defcoin-pool-timeline-bar(class=item.active ? 'active' : '', style=`--pool-start: ${item.startPct}%; --pool-span: ${item.spanPct}%;`)
                  .defcoin-pool-timeline-dates
                    span= item.startLabel
                    span= item.endLabel

  .col-12
    .card.card-default.border-0.cardSpacer.defcoin-reading
      .card-header
        h2#source-network Source code and network identity
      .card-body
        .defcoin-callout
          p.mb-0.defcoin-helper
            | Archived project sites help trace the source repositories. The notes below describe network settings in those code versions. Message bytes identify the expected network at the start of a peer message.
        .defcoin-page-grid.two-up
          .defcoin-stat-card
            span.stat-label Source links
            ul.mb-0
              each item in sourceAuthority
                li
                  a(href=item.url)= item.label
                  |  — #{item.note}
          .defcoin-stat-card
            span.stat-label Network settings
            ul.mb-0
              each note in networkIdentityNotes
                li= note

  .col-12
    .card.card-default.border-0.cardSpacer.defcoin-reading
      .card-header
        h2#historical-statistics Historical statistics
      .card-body
        .table-responsive(role='region', aria-labelledby='historical-statistics', tabindex='0')
          table.table.table-bordered.table-striped.table-hover
            thead
              tr
                th(scope='col') Snapshot
                th(scope='col') Earliest evidence
                th(scope='col') Latest evidence
                th(scope='col') Notes
            tbody
              each item in semiRetiredSnapshots
                tr
                  td
                    a(href=item.url)= item.label
                  td
                    +evidenceLink(item.firstSeen)
                  td
                    +evidenceLink(item.lastSeen)
                  td= item.note

  .col-12
    .card.card-default.border-0.cardSpacer.defcoin-reading
      .card-header
        h2#older-sites Older project sites
      .card-body
        .table-responsive(role='region', aria-labelledby='older-sites', tabindex='0')
          table.table.table-bordered.table-striped.table-hover
            thead
              tr
                th(scope='col') Site
                th(scope='col') Earliest evidence
                th(scope='col') Latest evidence
                th(scope='col') Archive
                th(scope='col') Notes
            tbody
              each item in retiredProjectSites
                tr
                  td= item.label
                  td
                    +evidenceLink(item.firstSeen)
                  td
                    +evidenceLink(item.lastSeen)
                  td
                    if item.archiveUrl
                      a(href=item.archiveUrl) Wayback search
                    else
                      span —
                  td= item.note

  .col-12
    .card.card-default.border-0.cardSpacer.defcoin-reading
      .card-header
        h2#older-tools Older games, wallets, and tools
      .card-body
        .table-responsive(role='region', aria-labelledby='older-tools', tabindex='0')
          table.table.table-bordered.table-striped.table-hover
            thead
              tr
                th(scope='col') Utility
                th(scope='col') Purpose
                th(scope='col') Earliest evidence
                th(scope='col') Latest evidence
                th(scope='col') Best link
                th(scope='col') Status
            tbody
              each item in shutteredUtilities
                tr
                  td
                    if item.originalUrl
                      a(href=item.originalUrl)= item.name
                    else
                      span= item.name
                  td= item.purpose
                  td
                    +evidenceLink(item.firstSeen)
                  td
                    +evidenceLink(item.lastSeen)
                  td
                    if item.bestUrl
                      a(href=item.bestUrl) Archive / best surviving link
                    else
                      span —
                  td= item.status

  .col-12
    .card.card-default.border-0.cardSpacer.defcoin-reading
      .card-header
        h2#older-pools Historical pool directory
      .card-body
        .table-responsive(role='region', aria-labelledby='older-pools', tabindex='0')
          table.table.table-bordered.table-striped.table-hover
            thead
              tr
                th(scope='col') Pool
                th(scope='col') Operator
                th(scope='col') Earliest evidence
                th(scope='col') Latest evidence
                th(scope='col') Original URL
                th(scope='col') Archive
                th(scope='col') Notes
            tbody
              each item in retiredPools
                tr
                  td= item.name
                  td= item.operator || 'Unknown'
                  td
                    +evidenceLink(item.firstSeen)
                  td
                    +evidenceLink(item.lastSeen)
                  td
                    if item.originalUrl
                      a(href=item.originalUrl)= item.originalUrl
                      if item.alternateUrls && item.alternateUrls.length
                        ul.defcoin-compact-link-list
                          each alternateUrl in item.alternateUrls
                            li
                              a(href=alternateUrl)= alternateUrl
                    else
                      span Unknown
                  td
                    if item.archiveUrl
                      a(href=item.archiveUrl) Wayback search
                    else
                      span —
                  td= item.note

  .col-12
    .card.card-default.border-0.cardSpacer.defcoin-reading
      .card-header
        h2#chain-records Early on-chain records
      .card-body
        .defcoin-callout
          p.mb-0.defcoin-helper
            | These transaction timestamps are listed oldest first. They document chain activity; they do not by themselves establish when the project was publicly launched.
        .table-responsive(role='region', aria-labelledby='chain-records', tabindex='0')
          table.table.table-bordered.table-striped.table-hover
            thead
              tr
                th(scope='col') Date / time
                th(scope='col') Event
                th(scope='col') Evidence
                th(scope='col') Notes
            tbody
              each item in chainTimeline
                tr
                  td= item.time
                  td= item.title
                  td
                    a(href=item.url) Block explorer transaction
                  td= item.note
